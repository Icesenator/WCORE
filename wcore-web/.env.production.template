# WCORE Production Environment Template
# Copy to .env.production.local and fill in real secrets
# Never commit .env.production.local

# --- Database ---
DB_USER=wcore
DB_PASSWORD=change-me-prod-64-chars
DB_NAME=wcore
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-prod

# --- API ---
API_PORT=4000
JWT_SECRET=change-me-prod-jwt-64-chars-minimum
CORS_ORIGIN=https://your-domain.com
# Scan requests per minute. The meaningful bound is RATE_LIMIT_SCAN_CHAIN_CHECKS below:
# it charges a request for the chains and wallets it covers, which is what a scan costs.
RATE_LIMIT_SCAN=2000
RATE_LIMIT_SCAN_CHAIN_CHECKS=5000
RATE_LIMIT_SCAN_CHAIN_CHECKS_ANON=1000

# Bounds on the async scan store; each job pins the results of every chain it covers.
SCAN_MAX_ASYNC_JOBS=200
SCAN_MAX_ASYNC_JOBS_PER_PRINCIPAL=32

# Required in production: encrypts stored exchange credentials. Without it the API
# refuses to read or write them rather than borrowing another secret.
CEX_SECRET=
# Shared with the cex-relay service.
RELAY_TOKEN=
# Required for the admin routes; while unset they answer 401.
ADMIN_TOKEN=
NON_EVM_SCAN_CONCURRENCY=5
RATE_LIMIT_CATCH_ALL=120
RATE_LIMIT_AUTH=30

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- WalletConnect ---
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-project-id

# --- Blockscout Pro API ---
# Used only for ERC-20 contract discovery hints, never for balances.
# Blockscout Pro docs use api.blockscout.com/v2/api with chain_id + apikey.
# Do not assume Pro quota applies to per-explorer /api/v2 routes without verification.
# If exhausted or unhealthy, scans fall back to RPC log discovery.
BLOCKSCOUT_API_KEY=
# BLOCKSCOUT_DISABLE=0
# BLOCKSCOUT_TIMEOUT_MS=2500
# BLOCKSCOUT_COOLDOWN_MS=600000

