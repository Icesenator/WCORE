# Dockerfile pour deploiement du relais avec contexte = ce dossier (railway up .).
# Chemins relatifs au dossier railway-rpc-relay (pas a la racine du monorepo).
# Le Dockerfile racine-contexte reste `Dockerfile` (chemins wcore-gsheet/...).
FROM node:22-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY server.js ./

ENV NODE_ENV=production
EXPOSE 8080
CMD ["node", "server.js"]
