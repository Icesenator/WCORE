# Dockerfile pour deploiement du relais avec contexte = ce dossier (railway up .)
# Chemins relatifs au dossier railway-relay (pas a la racine du monorepo).
# Le Dockerfile racine-contexte reste `Dockerfile` (chemins wcore-gsheet/railway-relay/...).
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY server.js ./

ENV NODE_ENV=production
# Unprivileged user shipped with the official image: the relay needs no root right.
USER node
CMD ["node", "server.js"]
